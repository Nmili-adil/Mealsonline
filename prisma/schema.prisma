// MealsOnline — Prisma schema
//
// Local development + tests run on SQLite (zero-config).
// Production targets MySQL: switch `provider` to "mysql" and point
// DATABASE_URL at the production database. The schema deliberately avoids
// SQLite-incompatible features (native enums, native JSON, @db.* annotations)
// so the same migrations apply cleanly to MySQL.
//
// Money is stored as integer minor units (centimes of MAD). 49 MAD = 4900.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Restaurant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  tagline      String?
  description  String?
  logoUrl      String?
  heroImageUrl String?
  address      String?
  city         String?
  phone        String?
  whatsappPhone String?
  // Serialized JSON text (portable across SQLite/MySQL).
  openingHours  String?
  currency      String   @default("MAD")
  deliveryFee   Int      @default(0) // minor units
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brands        Brand[]
  categories    Category[]
  products      Product[]
  modifierGroups ModifierGroup[]
  orders        OnlineOrder[]
}

model Brand {
  id           String   @id @default(cuid())
  restaurantId String
  externalId   String? // Caisse212 brand ID
  name         String
  slug         String
  tagline      String?
  description  String?
  logoUrl      String?
  imageUrl     String?
  accentColor  String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id])
  categories    Category[]
  products      Product[]
  modifierGroups ModifierGroup[]
  orders        OnlineOrder[]

  @@unique([restaurantId, externalId])
  @@unique([restaurantId, slug])
  @@index([restaurantId, isActive, sortOrder])
}

model Category {
  id               String   @id @default(cuid())
  restaurantId     String
  brandId          String?
  externalId       String? // Caisse212 category ID
  name             String
  slug             String
  description      String?
  imageUrl         String?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  visibleOnWebsite Boolean  @default(true)
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  brand      Brand?     @relation(fields: [brandId], references: [id])
  products   Product[]

  @@unique([restaurantId, externalId])
  @@unique([restaurantId, slug])
  @@index([restaurantId, brandId, sortOrder])
}

model Product {
  id          String   @id @default(cuid())
  restaurantId String
  brandId      String?
  categoryId   String?
  externalId   String? // Caisse212 product ID — the POS identity
  name         String
  slug         String
  description  String?
  ingredients  String?
  imageUrl     String?

  // Website-side presentation flags. POS availability stays separate below.
  caisseAvailable Boolean @default(true) // mirrored Caisse212 availability
  websiteVisible  Boolean @default(true) // website admin visibility
  isFeatured      Boolean @default(false)
  isPromoted      Boolean @default(false)
  sortOrder       Int     @default(0)
  promotionalSettings String? // serialized JSON (badge text, styling hints)
  archived        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  brand      Brand?     @relation(fields: [brandId], references: [id])
  category   Category?  @relation(fields: [categoryId], references: [id])

  variants          ProductVariant[]
  images            ProductImage[]
  modifierGroups    ProductModifierGroup[]
  orderItems        OnlineOrderItem[]

  @@unique([restaurantId, externalId])
  @@unique([restaurantId, slug])
  @@index([restaurantId, brandId, categoryId, websiteVisible])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  externalId String? // Caisse212 variant ID
  name       String
  price      Int // minor units — POS authoritative
  isDefault  Boolean  @default(false)
  sortOrder  Int      @default(0)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product  @relation(fields: [productId], references: [id])
  orderItems OnlineOrderItem[]

  @@unique([productId, externalId])
  @@index([productId, sortOrder])
}

model ModifierGroup {
  id           String   @id @default(cuid())
  restaurantId String
  brandId      String?
  externalId   String? // Caisse212 modifier group ID
  name         String
  minSelection Int      @default(0)
  maxSelection Int      @default(0)
  required     Boolean  @default(false)
  sortOrder    Int      @default(0)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  brand      Brand?     @relation(fields: [brandId], references: [id])
  modifiers  Modifier[]
  products   ProductModifierGroup[]

  @@unique([restaurantId, externalId])
}

model Modifier {
  id              String   @id @default(cuid())
  modifierGroupId String
  externalId      String? // Caisse212 modifier ID
  name            String
  price           Int      @default(0) // minor units
  sortOrder       Int      @default(0)
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@unique([modifierGroupId, externalId])
  @@index([modifierGroupId, sortOrder])
}

model ProductModifierGroup {
  id              String @id @default(cuid())
  productId       String
  modifierGroupId String
  sortOrder       Int    @default(0)

  product Product       @relation(fields: [productId], references: [id])
  group   ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@unique([productId, modifierGroupId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
}

// ---------------------------------------------------------------------------
// Synchronization
// ---------------------------------------------------------------------------

model MenuSyncRun {
  id               String    @id @default(cuid())
  provider         String    @default("caisse212")
  mode             String    @default("full") // full | incremental
  status           String    @default("running") // running | success | partial | failed
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  cursor           String?
  importedProducts Int       @default(0)
  updatedProducts  Int       @default(0)
  archivedProducts Int       @default(0)
  failedRecords    Int       @default(0)
  error            String?
  createdAt        DateTime  @default(now())

  @@index([provider, startedAt])
}

model MenuSyncCursor {
  id         String    @id @default(cuid())
  provider   String    @unique
  cursor     String?
  lastSyncAt DateTime?

  @@index([provider])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model OnlineOrder {
  id              String    @id @default(cuid())
  restaurantId    String
  brandId         String?
  reference       String    @unique // human reference shown to the customer
  trackingToken   String    @unique // high-entropy token required for tracking
  externalOrderId String? // stable idempotency key sent to Caisse212
  posOrderId      String? // Caisse212 POS order ID once accepted
  fulfillmentType String // delivery | pickup
  status          String    @default("pending_submission")
  // pending_submission | submitted | accepted | rejected | expired | cancelled | failed

  // Four independent dimensions — never collapsed into one value.
  acceptanceState  String @default("pending") // pending | accepted | rejected | expired
  preparationState String @default("pending") // pending | preparing | ready | dispatched | delivered
  paymentState     String @default("pending") // pending | paid | failed | refunded
  fulfillmentState String @default("pending") // pending | in_progress | completed | cancelled

  customerName        String
  phone               String
  deliveryAddress     String?
  deliveryInstructions String?
  orderNote           String?

  currency   String @default("MAD")
  subtotal   Int
  deliveryFee Int    @default(0)
  total      Int

  priceChanged        Boolean   @default(false)
  amountsAuthorized   Boolean   @default(false)
  acceptanceDeadlineAt DateTime?
  submittedAt         DateTime?
  acceptedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  brand      Brand?     @relation(fields: [brandId], references: [id])
  items      OnlineOrderItem[]
  payments   OrderPayment[]
  events     OrderStatusEvent[]

  @@unique([restaurantId, externalOrderId])
  @@unique([restaurantId, posOrderId])
  @@index([status, createdAt])
  @@index([phone])
}

model OnlineOrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String?
  externalProductId String?
  name              String // snapshot — immune to later catalog changes
  variantId         String?
  externalVariantId String?
  variantName       String?
  unitPrice         Int // minor units
  quantity          Int
  totalPrice        Int
  notes             String?
  sortOrder         Int      @default(0)

  order     OnlineOrder                 @relation(fields: [orderId], references: [id])
  product   Product?                    @relation(fields: [productId], references: [id])
  variant   ProductVariant?             @relation(fields: [variantId], references: [id])
  modifiers OnlineOrderItemModifier[]

  @@index([orderId])
}

model OnlineOrderItemModifier {
  id                 String @id @default(cuid())
  orderItemId        String
  externalModifierId String?
  modifierGroupName  String // snapshot
  modifierName       String // snapshot
  unitPrice          Int    @default(0)
  quantity           Int    @default(1)

  orderItem OnlineOrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
}

model OrderPayment {
  id          String    @id @default(cuid())
  orderId     String
  method      String // cash_on_delivery | pay_at_pickup
  state       String    @default("pending") // pending | paid | failed | refunded
  amount      Int
  externalRef String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order OnlineOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderStatusEvent {
  id              String    @id @default(cuid())
  orderId         String
  eventType       String // order.accepted | order.rejected | order.preparing | ...
  fromState       String?
  toState         String?
  payload         String? // serialized JSON (redacted)
  idempotencyKey  String?
  source          String    @default("system") // webhook | worker | admin | system
  createdAt       DateTime  @default(now())

  order OnlineOrder @relation(fields: [orderId], references: [id])

  @@unique([idempotencyKey])
  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------------------
// Integration reliability
// ---------------------------------------------------------------------------

model IntegrationOutbox {
  id             String    @id @default(cuid())
  eventType      String // order.submit | order.lookup
  payload        String // serialized JSON
  idempotencyKey String    @unique
  status         String    @default("pending") // pending | processing | succeeded | failed | expired
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8)
  nextAttemptAt  DateTime?
  lastError      String?
  correlationId  String?
  lockedAt       DateTime?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
}

model IntegrationInbox {
  id              String    @id @default(cuid())
  eventType       String
  externalEventId String    @unique
  payload         String // serialized JSON
  status          String    @default("received") // received | processed | failed | duplicate
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@index([eventType, receivedAt])
}

model IntegrationError {
  id            String   @id @default(cuid())
  scope         String // catalog | order | webhook
  provider      String   @default("caisse212")
  operation     String?
  correlationId String?
  message       String
  details       String?
  createdAt     DateTime @default(now())

  @@index([scope, provider, createdAt])
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("admin") // admin | operator
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions AdminSession[]
}

model AdminSession {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  adminUserId  String
  csrfToken    String
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // admin | system | customer
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   String? // serialized JSON (redacted)
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Website CMS / settings
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     String // serialized JSON
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  kind      String? // product | hero | brand | page
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  @@index([kind])
}
